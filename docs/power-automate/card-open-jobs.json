{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.4",
  "msteams": { "width": "Full" },
  "body": [
    {
      "type": "Container",
      "style": "warning",
      "bleed": true,
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                { "type": "TextBlock", "text": "🛠️", "size": "ExtraLarge", "spacing": "None" }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "CM-TRS Job Tracking · งานค้าง @{length(body('Filter_open_jobs'))} รายการ",
                  "size": "Large",
                  "weight": "Bolder",
                  "wrap": true,
                  "spacing": "None"
                },
                {
                  "type": "TextBlock",
                  "text": "Zone RC3-UDN · Region NorthEast · ประจำวันที่ @{formatDateTime(convertTimeZone(utcNow(), 'UTC', 'SE Asia Standard Time'), 'dd MMM yyyy')}",
                  "isSubtle": true,
                  "wrap": true,
                  "spacing": "None"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Medium",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "งานคงค้าง", "size": "Small", "isSubtle": true, "wrap": true, "spacing": "None" },
            { "type": "TextBlock", "text": "@{length(body('Filter_open_jobs'))}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "Critical", "size": "Small", "isSubtle": true, "wrap": true, "spacing": "None" },
            { "type": "TextBlock", "text": "@{length(body('Filter_critical'))}", "size": "ExtraLarge", "weight": "Bolder", "color": "Attention", "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "Major", "size": "Small", "isSubtle": true, "wrap": true, "spacing": "None" },
            { "type": "TextBlock", "text": "@{length(body('Filter_major'))}", "size": "ExtraLarge", "weight": "Bolder", "color": "Warning", "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "เกิน SLA", "size": "Small", "isSubtle": true, "wrap": true, "spacing": "None" },
            { "type": "TextBlock", "text": "@{length(body('Filter_over_sla'))}", "size": "ExtraLarge", "weight": "Bolder", "color": "Attention", "spacing": "None" }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "ตรวจสอบ ณ เวลา @{formatDateTime(convertTimeZone(utcNow(), 'UTC', 'SE Asia Standard Time'), 'dd-MMM-yy HH:mm')} (Asia/Bangkok) · SLA: Critical 3 ชม. · Major 10 ชม. · Minor 72 ชม. นับจาก Create Time",
      "wrap": true,
      "isSubtle": true,
      "size": "Small",
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "รายการงานค้าง (เรียงตามความรุนแรง)",
      "weight": "Bolder",
      "wrap": true,
      "separator": true,
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "@{join(body('Select_job_lines'), decodeUriComponent('%0A'))}",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "@{if(greater(length(body('Filter_open_jobs')), 10), concat('…และอีก ', sub(length(body('Filter_open_jobs')), 10), ' รายการ ดูทั้งหมดได้บน Dashboard'), '')}",
      "wrap": true,
      "isSubtle": true,
      "size": "Small"
    },
    {
      "type": "TextBlock",
      "text": "🤖 Generated by Power Automate",
      "isSubtle": true,
      "size": "Small",
      "wrap": true,
      "separator": true
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "📊 เปิด Dashboard",
      "url": "@{variables('DashboardUrl')}"
    }
  ]
}
