{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.4",
  "msteams": { "width": "Full" },
  "body": [
    {
      "type": "Container",
      "style": "emphasis",
      "bleed": true,
      "spacing": "None",
      "items": [
        {
          "type": "TextBlock",
          "text": "🛠️ CM-TRS Job Tracking",
          "size": "Large",
          "weight": "Bolder",
          "wrap": true,
          "spacing": "None"
        },
        {
          "type": "TextBlock",
          "text": "Zone @{first(body('Filter_Open'))?['Zone']} · Region @{first(body('Filter_Open'))?['Region']}",
          "isSubtle": true,
          "size": "Small",
          "wrap": true,
          "spacing": "Small"
        },
        {
          "type": "TextBlock",
          "text": "ประจำวันที่ @{formatDateTime(convertTimeZone(utcNow(),'UTC','SE Asia Standard Time'),'dd/MM/yyyy')} · @{length(body('Filter_Open'))} งานเปิด",
          "isSubtle": true,
          "size": "Small",
          "wrap": true,
          "spacing": "None"
        }
      ]
    },

    {
      "type": "ColumnSet",
      "spacing": "Medium",
      "columns": [
        {
          "type": "Column",
          "width": "25",
          "style": "attention",
          "spacing": "Small",
          "items": [
            { "type": "TextBlock", "text": "🔴", "size": "Large", "horizontalAlignment": "Center", "spacing": "None" },
            { "type": "TextBlock", "text": "@{length(body('Filter_Critical'))}", "size": "Large", "weight": "Bolder", "horizontalAlignment": "Center", "spacing": "None" },
            { "type": "TextBlock", "text": "Critical", "size": "Small", "isSubtle": true, "horizontalAlignment": "Center", "wrap": true, "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "25",
          "style": "warning",
          "spacing": "Small",
          "items": [
            { "type": "TextBlock", "text": "🟠", "size": "Large", "horizontalAlignment": "Center", "spacing": "None" },
            { "type": "TextBlock", "text": "@{length(body('Filter_Major'))}", "size": "Large", "weight": "Bolder", "horizontalAlignment": "Center", "spacing": "None" },
            { "type": "TextBlock", "text": "Major", "size": "Small", "isSubtle": true, "horizontalAlignment": "Center", "wrap": true, "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "25",
          "style": "accent",
          "spacing": "Small",
          "items": [
            { "type": "TextBlock", "text": "🟡", "size": "Large", "horizontalAlignment": "Center", "spacing": "None" },
            { "type": "TextBlock", "text": "@{length(body('Filter_Minor'))}", "size": "Large", "weight": "Bolder", "horizontalAlignment": "Center", "spacing": "None" },
            { "type": "TextBlock", "text": "Minor", "size": "Small", "isSubtle": true, "horizontalAlignment": "Center", "wrap": true, "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "25",
          "style": "emphasis",
          "spacing": "Small",
          "items": [
            { "type": "TextBlock", "text": "📋", "size": "Large", "horizontalAlignment": "Center", "spacing": "None" },
            { "type": "TextBlock", "text": "@{length(outputs('Top_Jobs'))}", "size": "Large", "weight": "Bolder", "horizontalAlignment": "Center", "spacing": "None" },
            { "type": "TextBlock", "text": "Showing", "size": "Small", "isSubtle": true, "horizontalAlignment": "Center", "wrap": true, "spacing": "None" }
          ]
        }
      ]
    },

    {
      "type": "TextBlock",
      "text": "**Status:** @{outputs('Status_Breakdown')}",
      "wrap": true,
      "size": "Small",
      "isSubtle": true,
      "spacing": "Small"
    },

    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            { "type": "Column", "width": "auto", "items": [ { "type": "TextBlock", "text": "Job ID",     "weight": "Bolder", "size": "Small", "wrap": true, "spacing": "None" } ] },
            { "type": "Column", "width": "auto", "items": [ { "type": "TextBlock", "text": "Priority",   "weight": "Bolder", "size": "Small", "wrap": true, "spacing": "None" } ] },
            { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "Status",     "weight": "Bolder", "size": "Small", "wrap": true, "spacing": "None" } ] }
          ]
        }
      ]
    },

    {
      "type": "Container",
      "spacing": "None",
      "items": [
        {
          "type": "ColumnSet",
          "$data": "@{body('Select_Rows')}",
          "separator": true,
          "spacing": "Small",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                { "type": "TextBlock", "text": "@{item()?['Job ID']}", "size": "Small", "weight": "Bolder", "wrap": true, "spacing": "None" }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "@{if(equals(item()?['Priority'],'Critical'),'🔴',if(equals(item()?['Priority'],'Major'),'🟠','🟡'))}",
                  "size": "Small",
                  "wrap": true,
                  "spacing": "None"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "@{item()?['Status']}",
                  "size": "Small",
                  "weight": "Bolder",
                  "wrap": true,
                  "spacing": "None",
                  "color": "@{if(equals(item()?['Status'],'Held'),'attention',if(equals(item()?['Status'],'Transfered'),'warning',if(or(equals(item()?['Status'],'On-Site'),equals(item()?['Status'],'Departed')),'good',if(equals(item()?['Status'],'Accepted'),'accent','default'))))}"
                }
              ]
            }
          ]
        }
      ]
    },

    {
      "type": "TextBlock",
      "text": "@{if(greater(sub(length(body('Filter_Open')),length(outputs('Top_Jobs'))),0), concat('⚠️ แสดง ', string(length(outputs('Top_Jobs'))), ' รายการแรก ยังมี **', string(sub(length(body('Filter_Open')),length(outputs('Top_Jobs')))), '** รายการ'), '✅ แสดงครบทั้งหมด')}",
      "wrap": true,
      "size": "Small",
      "color": "@{if(greater(sub(length(body('Filter_Open')),length(outputs('Top_Jobs'))),0),'warning','good')}",
      "spacing": "Medium"
    },

    {
      "type": "TextBlock",
      "text": "🤖 @{formatDateTime(convertTimeZone(utcNow(),'UTC','SE Asia Standard Time'),'dd/MM/yyyy HH:mm')}",
      "wrap": true,
      "size": "Small",
      "isSubtle": true,
      "spacing": "Small"
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "📊 Dashboard",
      "url": "https://panudechfight-gif.github.io/osp-improvement-dashboard/"
    },
    {
      "type": "Action.OpenUrl",
      "title": "📁 Excel Source",
      "url": "https://contoso.sharepoint.com/sites/NOC/Shared%20Documents/JobMonitor_CMTRS_Job_Tracking.xlsx"
    }
  ]
}
