{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.4",
  "msteams": { "width": "Full" },
  "body": [
    {
      "type": "Container",
      "style": "good",
      "bleed": true,
      "spacing": "None",
      "items": [
        {
          "type": "ColumnSet",
          "verticalContentAlignment": "Center",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                { "type": "TextBlock", "text": "✅", "size": "ExtraLarge", "spacing": "None" }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "CM-TRS Job Tracking · ไม่มีงานค้าง",
                  "size": "Large",
                  "weight": "Bolder",
                  "wrap": true,
                  "spacing": "None"
                },
                {
                  "type": "TextBlock",
                  "text": "Zone RC3-UDN · Region NorthEast · ประจำวันที่ @{outputs('Compose_ReportDate')}",
                  "isSubtle": true,
                  "size": "Small",
                  "wrap": true,
                  "spacing": "None"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "ตรวจสอบ ณ เวลา @{outputs('Compose_RunTime')} (Asia/Bangkok) — ไม่พบ Job ที่มีสถานะค้างในระบบ",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "🤖 Generated by Power Automate",
      "size": "Small",
      "isSubtle": true,
      "wrap": true,
      "spacing": "Small"
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "📊 เปิด Dashboard",
      "url": "https://panudechfight-gif.github.io/osp-improvement-dashboard/"
    }
  ]
}
